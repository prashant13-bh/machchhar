<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1022"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBackGuide"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_night_card"
            android:paddingHorizontal="14dp"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="#BAE6FD"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="FIELD MANUAL"
            android:textColor="#FFD166"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_night_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Fast Aim &amp; Reload"
                    android:textColor="#FFD166"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• Touch and drag anywhere on the screen to sweep the dotted laser sight.\n• Release your finger to blast locked targets instantly!\n• Tap the top-left 6-shot ammo pill anytime to reload early between waves."
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_night_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🦟 Mosquito Squad"
                    android:textColor="#7DD3FC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="🦟 Buzzer (1 HP): Standard pest (100 pts).\n🎧 DJ Singer (1 HP): Sings loudly — hit mid-song for MIC DROP (300 pts)!\n🥷 Shadow Ninja (1 HP): Agile flyer that dodges laser locks.\n🛡️ Armored Tank (2 HP): First hit stuns with a BONK!\n👑 King Mosquito (6 HP): Giant boss on Boss Nights (1,000 pts)!"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_night_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Power-Ups &amp; Fever Streaks"
                    android:textColor="#4ADE80"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="⚡ Zap Ammo: Infinite rapid ammo + chain hits (2 dmg).\n🌀 Sleep Coil: Slows every mosquito by 52%.\n💖 Deep Sleep: Restores +1 Sleep Heart.\n🔥 Every 5x combo streak awards +5 Sleep Coins!"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnPlayNowGuide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gold_button"
        android:text="▶ BACK TO BEDROOM"
        android:textColor="#1E1B4B"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
